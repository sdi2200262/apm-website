vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 8
    center: true
  }
}

task_cycle: {
  label: ""
  shape: sequence_diagram

  manager: Manager
  message_bus: Message Bus
  workers: Worker
  memory: Memory

  manager.width: 260
  manager.style: {
    fill: "#ffffff"
    stroke: "#000000"
    stroke-width: 2
    font-color: "#000000"
    font-size: 19
    bold: false
    border-radius: 0
    shadow: false
  }

  message_bus.width: 260
  message_bus.style: {
    fill: "#ffffff"
    stroke: "#000000"
    stroke-width: 2
    font-color: "#000000"
    font-size: 19
    bold: false
    border-radius: 0
    shadow: false
  }

  workers.width: 260
  workers.style: {
    fill: "#ffffff"
    stroke: "#000000"
    stroke-width: 2
    font-color: "#000000"
    font-size: 19
    bold: false
    border-radius: 0
    shadow: false
  }

  memory.width: 260
  memory.style: {
    fill: "#ffffff"
    stroke: "#000000"
    stroke-width: 2
    font-color: "#000000"
    font-size: 19
    bold: false
    border-radius: 0
    shadow: false
  }

  "For each Task": {
    style: {
      fill: "#ebebeb"
      stroke: "#000000"
      font-color: "#000000"
      font-size: 16
    }

    manager -> manager: " Select a ready Task and\nprepare its Task Prompt "
    manager -> message_bus: " Write Task Prompt\nto Task Bus "
    message_bus -> workers: " Read Task Prompt\nfrom Task Bus "
    workers -> workers: "  Execute and validate Task  "
    workers -> memory: " Write Task Log "
    workers -> message_bus: " Write Task Report\nto Report Bus "
    message_bus -> manager: " Read Task Report\nfrom Report Bus "
    memory -> manager: " Review Task Log "
    manager -> manager: " Update project state and\ndetermine next work "
  }

  manager."Project complete when no required Task remains": {
    style: {
      fill: "#ebebeb"
      stroke: "#000000"
      stroke-width: 1
      font-color: "#000000"
      font-size: 16
      bold: false
      italic: false
      border-radius: 0
      shadow: false
    }
  }

  (** -> **)[*].style: {
    stroke: "#000000"
    stroke-width: 2
    font-color: "#000000"
    font-size: 16
    border-radius: 10
  }
}
